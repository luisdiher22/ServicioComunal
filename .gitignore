## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache files
*.ide/
*.vs/
.vscode/

# Others
*.dbmdl
*.bak
*.log
*.ldf
*.mdf
*.ndf

# Rider
.idea/
*.iml

# Auto-generated files
*.GeneratedMSBuildEditorConfig.editorconfig

# Aider-specific
.aider*

# Local configuration and secrets
.env
.env.*
!.env.example
**/appsettings.*.Local.json

# Local build and package output
**/node_modules/
**/TestResults/
**/coverage/
**/publish/
**/*.pubxml.user

# User uploaded files. Keep only the bundled, named form templates.
/ServicioComunal/ServicioComunal/wwwroot/uploads/entregas/
/ServicioComunal/ServicioComunal/wwwroot/uploads/formularios/*
!/ServicioComunal/ServicioComunal/wwwroot/uploads/formularios/.gitkeep
!/ServicioComunal/ServicioComunal/wwwroot/uploads/formularios/Anexo*.pdf
!/ServicioComunal/ServicioComunal/wwwroot/uploads/formularios/Carta*.pdf
!/ServicioComunal/ServicioComunal/wwwroot/uploads/formularios/Informe*.pdf
